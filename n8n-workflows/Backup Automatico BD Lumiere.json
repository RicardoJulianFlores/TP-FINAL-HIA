    {
      "parameters": {
        "command": "FECHA=$(date +%Y-%m-%d)\nARCHIVO=\"/backups/backup_trabajoFinal_${FECHA}.sql.gz\"\nUMBRAL_MINIMO=500\n\nif [ ! -f \"$ARCHIVO\" ]; then\n  echo \"{\\\"ok\\\": false, \\\"estado\\\": \\\"FALTANTE\\\", \\\"archivo\\\": \\\"$ARCHIVO\\\", \\\"tamano_bytes\\\": 0, \\\"detalle\\\": \\\"No se encontro el archivo de respaldo diario.\\\"}\"\n  exit 0\nfi\n\nTAMANO=$(stat -c%s \"$ARCHIVO\")\n\nif ! gzip -t \"$ARCHIVO\" 2>/dev/null; then\n  echo \"{\\\"ok\\\": false, \\\"estado\\\": \\\"CORRUPTO\\\", \\\"archivo\\\": \\\"$ARCHIVO\\\", \\\"tamano_bytes\\\": $TAMANO, \\\"detalle\\\": \\\"Fallo la validacion de integridad gzip -t.\\\"}\"\n  exit 0\nfi\n\nif [ \"$TAMANO\" -lt \"$UMBRAL_MINIMO\" ]; then\n  echo \"{\\\"ok\\\": false, \\\"estado\\\": \\\"TAMANO_INSUFICIENTE\\\", \\\"archivo\\\": \\\"$ARCHIVO\\\", \\\"tamano_bytes\\\": $TAMANO, \\\"detalle\\\": \\\"El archivo pesa menos del umbral minimo esperado ($UMBRAL_MINIMO bytes).\\\"}\"\n  exit 0\nfi\n\necho \"{\\\"ok\\\": true, \\\"estado\\\": \\\"VALIDO\\\", \\\"archivo\\\": \\\"$ARCHIVO\\\", \\\"tamano_bytes\\\": $TAMANO, \\\"detalle\\\": \\\"Respaldo integro y verificado correctamente.\\\"}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "id": "7182fba9-e38b-4402-b747-20ef041eecb0",
      "name": "Execute Command"
    },
