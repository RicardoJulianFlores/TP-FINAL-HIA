    {
      "parameters": {
        "jsCode": "const markdownText = $input.first().json.content?.parts?.[0]?.text \n  || $input.first().json.text \n  || JSON.stringify($input.first().json);\n\nconst fecha = new Date().toISOString().split('T')[0];\nconst fileName = `reporte-rendimiento-IA-${fecha}.md`;\n\nreturn [\n  {\n    json: {\n      fileName,\n      markdownText\n    },\n    binary: {\n      data: {\n        data: Buffer.from(markdownText, 'utf8').toString('base64'),\n        mimeType: 'text/markdown',\n        fileName: fileName\n      }\n    }\n  }\n];"
      },
