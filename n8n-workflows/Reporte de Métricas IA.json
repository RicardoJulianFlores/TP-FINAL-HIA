    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst cpuVal = items[0]?.json?.data?.result?.[0]?.value?.[1] || \"Sin datos\";\nconst ramResults = items[1]?.json?.data?.result || [];\nconst pgResults = items[2]?.json?.data?.result || [];\n\nconst ramDetalle = ramResults.map(r => {\n  const nombre = r.metric.name || \"contenedor\";\n  const mb = parseFloat(r.value[1]).toFixed(2);\n  return `- ${nombre}: ${mb} MB`;\n}).join('\\n');\n\nconst pgDetalle = pgResults.map(r => {\n  const db = r.metric.datname || \"postgres\";\n  return `- Base \"${db}\": ${r.value[1]} conexiones activas`;\n}).join('\\n');\n\nconst resumenMetricas = `\nFECHA DEL REPORTE: ${new Date().toISOString()}\n1. Uso promedio de CPU del host (última hora): ${parseFloat(cpuVal).toFixed(2)}%\n2. Top 5 contenedores por consumo de memoria RAM:\n${ramDetalle || \"- Sin métricas de cAdvisor\"}\n3. Estado de conexiones en PostgreSQL:\n${pgDetalle || \"- Sin métricas de Postgres\"}\n`.trim();\n\nreturn [{ json: { resumenMetricas } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
