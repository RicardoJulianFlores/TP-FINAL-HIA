# ==========================================
# Base de Datos (PostgreSQL Clúster Replicado) y pgAdmin
# ==========================================
DB_NAME=trabajoFinal
DB_USER=postgres
DB_PASSWORD=

# Configuración de Replicación Streaming (3 Nodos: Primario + 2 Réplicas)
DB_REPLICA_USER=replicator
DB_REPLICA_PASSWORD=replica_password_segura
DB_REPLICA_SLOT=replica_slot
DB_REPLICA_SLOT_2=replica_slot_2

# Hosts del Clúster (Balanceo de Lecturas y Conexión Backend)
DB_WRITE_HOST=db
DB_WRITE_PORT=5432
DB_READ_HOST=db-replica
DB_READ_PORT=5432
DB_READ_HOST_2=db-replica-2
DB_READ_PORT_2=5432
DB_READ_HOSTS=db-replica,db-replica-2

PGADMIN_EMAIL=admin@lumiere.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ==========================================
# Variables de Autenticación y Backend
# ==========================================
PORT=3000
JWT_SECRET=secretkey
